# Copy to .env and fill in. Never commit the real .env.

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather. Also the key used to verify Mini App initData.
BOT_TOKEN=
# Telegram user ids with admin rights (comma separated)
ADMIN_IDS=
# Public HTTPS base URL where this app is served; the Mini App lives at <WEBAPP_URL>/tma
WEBAPP_URL=https://your-domain.example.com

# --- Admin API --------------------------------------------------------------
# Bearer token for /api/admin/* and the /admin-panel page (min 24 chars).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# --- Database ---------------------------------------------------------------
# SQLite for local development; docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///qadam_club.db
# Only used by docker-compose for the bundled PostgreSQL service.
POSTGRES_PASSWORD=change-me

# --- Behaviour --------------------------------------------------------------
# IANA timezone for submission windows, streak days and schedules
TIMEZONE=Asia/Tashkent
# Daily reminder time (HH:MM, in TIMEZONE)
REMINDER_TIME=21:00
# Max age of Mini App initData in seconds (default: 24h)
INIT_DATA_MAX_AGE=86400
# Development server debug mode (never enable in production)
FLASK_DEBUG=false
